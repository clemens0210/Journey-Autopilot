# Kopiere diese Datei zu ".env" und fülle die Werte aus.

# === University of Cologne GPT (OpenAI-kompatibel) ===
# Key, Endpunkt und Modellname bekommst du vom GPT-Service der Uni Köln.
UNI_GPT_API_KEY=DEIN_UNI_KEY_HIER
UNI_GPT_BASE_URL=https://DEIN_UNI_ENDPUNKT/v1
UNI_GPT_MODEL=DEIN_UNI_MODELLNAME

# === DB-Live-Daten-Sidecar (db_service/) ===
# Adresse des lokal laufenden db-vendo-client-Sidecars. Default passt für
# "make db-service". Nur ändern, wenn der Sidecar woanders läuft.
DB_API_URL=http://127.0.0.1:3000
DB_API_TIMEOUT=20
