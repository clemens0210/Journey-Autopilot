# Copy this file to ".env" and fill in the values.

# === University of Cologne GPT (OpenAI-compatible) ===
# Key, endpoint and model name are provided by the GPT service of Uni Cologne.
UNI_GPT_API_KEY=YOUR_UNI_KEY_HERE
UNI_GPT_BASE_URL=https://YOUR_UNI_ENDPOINT/v1
UNI_GPT_MODEL=YOUR_UNI_MODEL_NAME
# Optional: keep LiteLLM internals quiet during demos.
LITELLM_LOG=CRITICAL

# === AWS Bedrock (Claude Sonnet 4.6 / Haiku 4.5) ===
# IAM access key for a user with AmazonBedrockFullAccess policy.
# Create in IAM Console → Users → your user → Security credentials → Create access key.
# Region defaults to us-east-1; model defaults to the us cross-region inference profile.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# bedrock_claude alias (stronger tier):
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
# bedrock_haiku alias (fast/cheap tier) — cross-region inference profile;
# the plain foundation-model ID is not invokable on-demand:
# BEDROCK_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# === Microsoft Entra (Outlook Calendar) ===
# Client ID from the app registration in the Entra Admin Center.
# Without these values, the Planner falls back to mock data.
MS_ENTRA_CLIENT_ID=your-client-id
# Tenant: "consumers" (personal), "organizations" (work/school), or GUID
MS_ENTRA_TENANT_ID=consumers

# === Twilio (WhatsApp Connector) ===
# Login Data from Twilio Console (https://console.twilio.com).
# TWILIO_WHATSAPP_FROM is the Sandbox-Number in the Format "whatsapp:+14155238886".
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Demo-Telephonnumber (WhatsApp Connector Demo) ===
# E.164-Format, z. B. +49171xxxxxxx.
# Nur DEMO_TRAVELER_NUMBER is necessary - without it scenarios/happy_path.py
# skips the WhatsApp-Part. The rest is optional.
DEMO_TRAVELER_NUMBER=+49171xxxxxxx
DEMO_CLIENT_NUMBER=+49172xxxxxxx
DEMO_COLLEAGUE_NUMBER=+49173xxxxxxx
DEMO_PRIVATE_NUMBER=+49174xxxxxxx

# === Webhook-Server (WhatsApp Connector) ===
# PORT: Port, uvicorn listens to.
# WEBHOOK_BASE_URL: public URL (e.g. ngrok-Tunnel), Twilio gets as
# Callback-Target for incoming messages.
PORT=8000
WEBHOOK_BASE_URL=https://dein-ngrok-tunnel.ngrok-free.app
# Add this ending to the WEBHOOK_BASE_URL and add it in Twilio:
# https://6494-2a02-3035-66a-2078-25c4-78be-e9b2-19e3.ngrok-free.app/whatsapp/reply

# === DB-Live-Daten-Sidecar (db_service/) ===
# Adresse des lokal laufenden db-vendo-client-Sidecars. Default passt für
# "cd db_service && npm start". Nur ändern, wenn der Sidecar woanders läuft.
DB_API_URL=http://127.0.0.1:3000
DB_API_TIMEOUT=20
