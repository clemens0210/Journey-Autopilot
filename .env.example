# Kopiere diese Datei zu ".env" und fülle die Werte aus.
# Die fertige .env auch nach journey_autopilot/.env kopieren, damit adk web/run
# sie findet (ADK lädt .env aus dem Agenten-Verzeichnis).

# === University of Cologne GPT (OpenAI-kompatibel) ===
# Key, Endpunkt und Modellname bekommst du vom GPT-Service der Uni Köln.
# Der Endpunkt muss /v1 am Ende enthalten.
UNI_GPT_API_KEY=DEIN_UNI_KEY_HIER
UNI_GPT_BASE_URL=https://DEIN_UNI_ENDPUNKT/v1
UNI_GPT_MODEL=DEIN_UNI_MODELLNAME

# === Twilio (WhatsApp Connector) ===
# Zugangsdaten aus der Twilio Console (https://console.twilio.com).
# TWILIO_WHATSAPP_FROM ist die Sandbox-Nummer im Format "whatsapp:+14155238886".
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# === Demo-Telefonnummern (WhatsApp Connector Demo) ===
# E.164-Format, z. B. +49171xxxxxxx.
# Nur DEMO_TRAVELER_NUMBER ist Pflicht — ohne sie überspringt run_demo.py
# den WhatsApp-Teil. Die übrigen sind optional.
DEMO_TRAVELER_NUMBER=+49171xxxxxxx
DEMO_CLIENT_NUMBER=+49172xxxxxxx
DEMO_COLLEAGUE_NUMBER=+49173xxxxxxx
DEMO_PRIVATE_NUMBER=+49174xxxxxxx

# === Webhook-Server (WhatsApp Connector) ===
# PORT: Port, auf dem uvicorn lauscht.
# WEBHOOK_BASE_URL: öffentliche URL (z. B. ngrok-Tunnel), die Twilio als
# Callback-Ziel für eingehende Nachrichten bekommt.
PORT=8000
WEBHOOK_BASE_URL=https://dein-ngrok-tunnel.ngrok-free.app
# Add this ending to the WEBHOOK_BASE_URL and add it in Twilio:
# https://6494-2a02-3035-66a-2078-25c4-78be-e9b2-19e3.ngrok-free.app/whatsapp/reply
